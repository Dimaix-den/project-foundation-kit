# ─── ОБЯЗАТЕЛЬНЫЕ ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...           # Ключ с console.anthropic.com
TELEGRAM_BOT_TOKEN=1234567890:ABC...   # Токен от @BotFather

# ─── ПУБЛИКАЦИЯ ──────────────────────────────────────────────────
PUBLISH_CHANNEL=@your_channel_username  # Куда публиковать одобренный контент

# ─── БРЕНД ───────────────────────────────────────────────────────
BRAND_NICHE=B2B бизнес и предпринимательство
BRAND_TONE=профессиональный, экспертный, с практической пользой
BRAND_LANGUAGE=русский
BRAND_AUDIENCE=предприниматели, руководители, B2B-специалисты

# ─── МОДЕЛЬ (необязательно) ───────────────────────────────────────
# claude-haiku-4-5-20251001   → дёшево и быстро
# claude-sonnet-4-6           → баланс качества и цены (по умолчанию)
# claude-opus-4-6             → максимальное качество
MODEL=claude-sonnet-4-6

# ─── БЕЗОПАСНОСТЬ (необязательно) ────────────────────────────────
# Telegram user IDs через запятую. Оставь пустым — бот ответит всем.
ALLOWED_USER_IDS=

# ─── ТОПИКИ TELEGRAM (заполни после настройки суперчата) ──────────
# Как получить: напиши /topic_id в каждом топике чата
TOPIC_ANALYTICS=
TOPIC_DRAFTS=
TOPIC_VISUALS=
TOPIC_REVIEW=
TOPIC_PUBLISHED=
